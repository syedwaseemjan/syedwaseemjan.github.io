---
interface Props {
  title: string;
  author: string;
  image_url: string;
  amazon_url: string;
  note?: string;
}

const { title, author, image_url, amazon_url, note } = Astro.props;
---

<article class:list={['book', note && 'book--noted']}>
  <a href={amazon_url} target="_blank" rel="noopener noreferrer" class="book__cover-link">
    <img
      src={`/assets/img/books/${image_url}`}
      alt=""
      class="book__img"
      loading="lazy"
      width="72"
      height="108"
    />
  </a>
  <div class="book__body">
    <a href={amazon_url} target="_blank" rel="noopener noreferrer" class="book__title">
      {title}
    </a>
    <p class="book__author">{author}</p>
    {note && <p class="book__note">{note}</p>}
  </div>
</article>

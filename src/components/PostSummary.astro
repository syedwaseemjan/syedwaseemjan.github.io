---
import { formatDate, readingTime, excerpt } from '../lib/utils';

interface Props {
  title: string;
  href: string;
  date: Date;
  body: string;
  categories: string[];
  meta?: string;
}

const { title, href, date, body, categories, meta } = Astro.props;
const readTime = readingTime(body);
const summary = excerpt(body);
---

<article class="post-item">
  <a class="post-item__link heading-2 heading-2--link" href={href}>{title}</a>

  <p class="post-item__content">{summary}</p>

  <div class="post-item__meta">
    <span class="post-item__details">
      {formatDate(date)}{meta && ` • ${meta}`}
      | {readTime}
    </span>
    <div class="post-item__categories">
      {
        categories.map((category) => (
          <a href={`/tags/${category}`} class="tag">
            # {category}
          </a>
        ))
      }
    </div>
    <span class="post-item__more" aria-hidden="true">Read &rarr;</span>
  </div>
</article>

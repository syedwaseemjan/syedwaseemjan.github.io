---
import { SITE } from '../consts';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-content">
    <nav class="footer-nav">
      <a href="/books" class="footer-nav__link">Books</a>
      <a href={`mailto:${SITE.email}`} class="footer-nav__link">Contact</a>
    </nav>

    <div class="footer-about">
      <div class="footer-about__box">
        <h3 class="heading-3 mb-sm">Background</h3>
        <ul class="footer-about__list">
          <li class="footer-about__item">CS since 2008</li>
          <li class="footer-about__item">B.Sc. Software Engineering, 2012</li>
          <li class="footer-about__item">{SITE.experienceYears} years in industry</li>
        </ul>
      </div>
      <div class="footer-about__box">
        <h3 class="heading-3 mb-sm">Focus areas</h3>
        <ul class="footer-about__list">
          <li class="footer-about__item">Backend architecture</li>
          <li class="footer-about__item">AWS &amp; DevOps</li>
          <li class="footer-about__item">Python &amp; JavaScript</li>
        </ul>
      </div>
      <div class="footer-about__box">
        <h3 class="heading-3 mb-sm">Currently exploring</h3>
        <ul class="footer-about__list">
          <li class="footer-about__item">Monorepo architecture</li>
          <li class="footer-about__item">Infrastructure cost optimization</li>
          <li class="footer-about__item">Automated code quality</li>
        </ul>
      </div>
    </div>

    <div class="social-links">
      <ul class="social-links__list">
        <li class="social-links__item">
          <a href={`mailto:${SITE.email}`} title="Email" class="social-links__link">
            <i class="social-links__icon fas fa-envelope" aria-hidden="true"></i>
            <span>Email</span>
          </a>
        </li>
        <li class="social-links__item">
          <a
            href={`https://linkedin.com/in/${SITE.linkedUsername}`}
            title="LinkedIn"
            class="social-links__link">
            <i class="social-links__icon fab fa-linkedin" aria-hidden="true"></i>
            <span>LinkedIn</span>
          </a>
        </li>
        <li class="social-links__item">
          <a
            href={`https://github.com/${SITE.githubUsername}`}
            title="GitHub"
            class="social-links__link">
            <i class="social-links__icon fab fa-github" aria-hidden="true"></i>
            <span>GitHub</span>
          </a>
        </li>
        <li class="social-links__item">
          <a
            href={`https://stackoverflow.com/users/${SITE.stackoverflowUsername}`}
            title="Stack Overflow"
            class="social-links__link">
            <i class="social-links__icon fab fa-stack-overflow" aria-hidden="true"></i>
            <span>Stack Overflow</span>
          </a>
        </li>
      </ul>
    </div>

    <p class="footer-copy">&copy; {year} {SITE.author}</p>
  </div>
</footer>

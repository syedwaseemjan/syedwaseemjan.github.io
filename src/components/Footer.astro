---
import { SITE } from '../consts';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-content">
    <nav class="footer-nav" aria-label="Footer">
      <a href="/books" class="footer-nav__link">Books</a>
      <a href="/feed.xml" class="footer-nav__link">RSS</a>
    </nav>

    <div class="social-links">
      <ul class="social-links__list">
        <li class="social-links__item">
          <a href={`mailto:${SITE.email}`} title="Email" class="social-links__link">
            <i class="social-links__icon fas fa-envelope" aria-hidden="true"></i>
            <span>Email</span>
          </a>
        </li>
        <li class="social-links__item">
          <a
            href={`https://linkedin.com/in/${SITE.linkedUsername}`}
            title="LinkedIn"
            class="social-links__link"
            target="_blank"
            rel="noopener noreferrer">
            <i class="social-links__icon fab fa-linkedin" aria-hidden="true"></i>
            <span>LinkedIn</span>
          </a>
        </li>
        <li class="social-links__item">
          <a
            href={`https://github.com/${SITE.githubUsername}`}
            title="GitHub"
            class="social-links__link"
            target="_blank"
            rel="noopener noreferrer">
            <i class="social-links__icon fab fa-github" aria-hidden="true"></i>
            <span>GitHub</span>
          </a>
        </li>
        <li class="social-links__item">
          <a
            href={`https://stackoverflow.com/users/${SITE.stackoverflowUsername}`}
            title="Stack Overflow"
            class="social-links__link"
            target="_blank"
            rel="noopener noreferrer">
            <i class="social-links__icon fab fa-stack-overflow" aria-hidden="true"></i>
            <span>Stack Overflow</span>
          </a>
        </li>
      </ul>
    </div>

    <p class="footer-copy">&copy; {year} {SITE.author}</p>
  </div>
</footer>

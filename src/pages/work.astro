---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';
import { projects } from '../data/projects';
---

<BaseLayout title={`Work | ${SITE.title}`} canonicalPath="/work">
  <section class="section-projects">
    <h2 class="heading-2 heading-2--dark mb-md">Work</h2>
    <p class="text text--lead mb-lg">
      Places I've spent time building things over the last {SITE.experienceYears} years.
    </p>

    <ol class="work-list">
      {
        projects.map((project) =>
          project.kind === 'gap' ? (
            <li id={project.id} class="work-item work-item--gap">
              <p class="work-item__period">{project.period}</p>
              <p class="work-item__details">{project.details}</p>
            </li>
          ) : (
            <li id={project.id} class="work-item">
              <div class="work-item__body">
                <p class="work-item__period">{project.period}</p>
                <div class="work-item__heading">
                  {project.link ? (
                    <a
                      href={project.link}
                      class="work-item__title"
                      target="_blank"
                      rel="noopener noreferrer">
                      {project.title}
                    </a>
                  ) : (
                    <h3 class="work-item__title">{project.title}</h3>
                  )}
                  <span class="work-item__role">{project.role}</span>
                </div>
                <p class="work-item__details" set:html={project.details} />
              </div>
              <img
                src={project.thumbnail}
                alt={project.thumbnailalt}
                class:list={['work-item__img', project.visual === 'mark' && 'work-item__img--mark']}
                loading="lazy"
                width="200"
                height="140"
              />
            </li>
          ),
        )
      }
    </ol>
  </section>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Book from '../components/Book.astro';
import { SITE } from '../consts';
import { booksNovels, booksSelfHelp, booksTechnical } from '../data/books';
---

<BaseLayout title={`Books | ${SITE.title}`} canonicalPath="/books">
  <section class="section-books">
    <div class="section-books__category">
      <h2 class="heading-2 heading-2--dark mb-hg">Here is the list of the few books I have read.</h2>
      <h3 class="heading-2 section-books__heading">Novels</h3>
      <div class="section-books__list">
        {booksNovels.map((book) => <Book {...book} />)}
      </div>
    </div>
    <div class="section-books__category">
      <h3 class="heading-2 section-books__heading">Self Help</h3>
      <div class="section-books__list">
        {booksSelfHelp.map((book) => <Book {...book} />)}
      </div>
    </div>
    <div class="section-books__category">
      <h3 class="heading-2 section-books__heading">Technical Books</h3>
      <div class="section-books__list">
        {booksTechnical.map((book) => <Book {...book} />)}
      </div>
    </div>
  </section>
</BaseLayout>
